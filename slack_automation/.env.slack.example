# =====================================================================
# StayVista Slack Operations Configuration
# =====================================================================

# 1. Slack Incoming Webhook (Get from https://api.slack.com/apps -> Incoming Webhooks)
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE

# 2. Target Channel (e.g. #reconciliation-alerts, #ops-discrepancies)
SLACK_CHANNEL=#reconciliation-alerts

# 3. Bot Display Customization
SLACK_BOT_NAME=StayVista Reconciliation Engine
SLACK_BOT_ICON_EMOJI=:rotating_light:

# 4. Alert Tuning
SLACK_MAX_ITEMS=8
SLACK_MENTION_CHANNEL=false
SLACK_NOTIFY_ON_ZERO=true
