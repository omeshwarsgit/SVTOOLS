# =====================================================================
# StayVista Automated Reconciliation Engine & Free Office Email Dispatch
# =====================================================================

# ---------------------------------------------------------------------
# 1. OFFICE EMAIL SENDER CONFIGURATION (100% Free via standard SMTP)
# NOTE: DO NOT use personal email addresses. Use your official office /
# system / service notification email account.
# ---------------------------------------------------------------------

# OPTION A: Google Workspace / Corporate Gmail
# For 2FA-enabled accounts, generate a free 16-character App Password at:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=reconciliation-alerts@stayvista.com
SMTP_PASSWORD=your_office_app_password_here
SMTP_FROM_NAME=StayVista Reconciliation Engine
SMTP_USE_TLS=True

# OPTION B: Microsoft 365 / Office 365 (Uncomment if using Microsoft)
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=reconciliation@stayvista.com
# SMTP_PASSWORD=your_office365_password
# SMTP_FROM_NAME=StayVista Reconciliation Engine
# SMTP_USE_TLS=True

# OPTION C: Custom Corporate SMTP / Relay (Uncomment if using internal SMTP)
# SMTP_HOST=mail.yourcompany.com
# SMTP_PORT=587
# SMTP_USER=notifications@yourcompany.com
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM_NAME=StayVista Operations

# ---------------------------------------------------------------------
# 2. RECIPIENT EMAILS (Comma-separated list of team/manager emails)
# Everyone in this list will receive the same comprehensive reconciliation report
# and attached multi-sheet Excel file.
# ---------------------------------------------------------------------
RECIPIENT_EMAILS=operations@stayvista.com, management@stayvista.com, team@stayvista.com

# ---------------------------------------------------------------------
# 3. SLACK INTEGRATION (100% Free)
# Option 1: Slack Channel Email (Recommended)
# You can paste your Slack channel's email address directly into RECIPIENT_EMAILS above!
# (Get it in Slack: Channel Details -> Integrations -> "Send emails to this channel")
#
# Option 2: Slack Incoming Webhook (For rich interactive Block Kit cards & @RM tagging)
# (Get it at https://api.slack.com/apps -> Incoming Webhooks)
# ---------------------------------------------------------------------
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL_HERE
SLACK_CHANNEL=#reconciliation-alerts

# ---------------------------------------------------------------------
# 4. FOLDER WATCHER CONFIGURATION
# Drop your new SU & PMS sheets here for instant automated processing & emailing
# ---------------------------------------------------------------------
WATCH_FOLDER=data/incoming
PROCESSED_FOLDER=data/processed
POLL_INTERVAL_SECONDS=5
